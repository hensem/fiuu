# =====================================
# 🐳 DOCKER & MYSQL
# =====================================
docker/mysql_data/      # ignore MySQL runtime data only
*.sock
*.pid
*.cnf
*.ibd
*.ib_logfile*

# ✅ Keep backups (versioned .sql files)
!docker/mysql_backup/
!docker/mysql_backup/*.sql

# =====================================
# ⚙️ LARAVEL BACKEND
# =====================================
docker/src/vendor/
docker/src/node_modules/
docker/src/storage/
docker/src/bootstrap/cache/

# =====================================
# 💻 SYSTEM / EDITOR / LOGS
# =====================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
